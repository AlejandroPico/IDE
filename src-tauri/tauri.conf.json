{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IDE",
  "version": "0.2.1",
  "identifier": "io.github.alejandropico.ide",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 0.0.0.0 --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IDE · Entorno de desarrollo integral",
        "width": 1440,
        "height": 900,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "IDE híbrido multilenguaje",
    "longDescription": "Entorno de desarrollo integrado, modular y multilenguaje con editor inteligente, ejecución local y proyectos compatibles con web y escritorio.",
    "copyright": "© 2026 Alejandro Pico",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
